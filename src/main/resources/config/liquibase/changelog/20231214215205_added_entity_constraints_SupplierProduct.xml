<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity SupplierProduct.
    -->
    <changeSet id="20231214215205-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="product_id"
                                 baseTableName="supplier_product"
                                 constraintName="fk_supplier_product__product_id"
                                 referencedColumnNames="id"
                                 referencedTableName="product"
                                 />

        <addForeignKeyConstraint baseColumnNames="party_id"
                                 baseTableName="supplier_product"
                                 constraintName="fk_supplier_product__party_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="quantity_uom_id"
                                 baseTableName="supplier_product"
                                 constraintName="fk_supplier_product__quantity_uom_id"
                                 referencedColumnNames="id"
                                 referencedTableName="uom"
                                 />

        <addForeignKeyConstraint baseColumnNames="currency_uom_id"
                                 baseTableName="supplier_product"
                                 constraintName="fk_supplier_product__currency_uom_id"
                                 referencedColumnNames="id"
                                 referencedTableName="uom"
                                 />
    </changeSet>
</databaseChangeLog>
