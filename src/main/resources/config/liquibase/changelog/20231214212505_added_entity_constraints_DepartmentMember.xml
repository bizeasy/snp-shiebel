<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity DepartmentMember.
    -->
    <changeSet id="20231214212505-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="department_id"
                                 baseTableName="department_member"
                                 constraintName="fk_department_member__department_id"
                                 referencedColumnNames="id"
                                 referencedTableName="department"
                                 />

        <addForeignKeyConstraint baseColumnNames="party_id"
                                 baseTableName="department_member"
                                 constraintName="fk_department_member__party_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="role_type_id"
                                 baseTableName="department_member"
                                 constraintName="fk_department_member__role_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="role_type"
                                 />
    </changeSet>
</databaseChangeLog>
