<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Invoice.
    -->
    <changeSet id="20231214224605-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="invoice_type_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__invoice_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="invoice_type"
                                 />

        <addForeignKeyConstraint baseColumnNames="order_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__order_id"
                                 referencedColumnNames="id"
                                 referencedTableName="sys_order"
                                 />

        <addForeignKeyConstraint baseColumnNames="from_party_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__from_party_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="to_party_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__to_party_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="role_type_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__role_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="role_type"
                                 />

        <addForeignKeyConstraint baseColumnNames="status_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__status_id"
                                 referencedColumnNames="id"
                                 referencedTableName="status"
                                 />

        <addForeignKeyConstraint baseColumnNames="contact_mech_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__contact_mech_id"
                                 referencedColumnNames="id"
                                 referencedTableName="contact_mech"
                                 />

        <addForeignKeyConstraint baseColumnNames="currency_uom_id"
                                 baseTableName="invoice"
                                 constraintName="fk_invoice__currency_uom_id"
                                 referencedColumnNames="id"
                                 referencedTableName="uom"
                                 />
    </changeSet>
</databaseChangeLog>
