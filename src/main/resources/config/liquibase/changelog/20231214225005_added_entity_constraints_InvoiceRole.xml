<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity InvoiceRole.
    -->
    <changeSet id="20231214225005-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="invoice_id"
                                 baseTableName="invoice_role"
                                 constraintName="fk_invoice_role__invoice_id"
                                 referencedColumnNames="id"
                                 referencedTableName="invoice"
                                 />

        <addForeignKeyConstraint baseColumnNames="invoice_item_id"
                                 baseTableName="invoice_role"
                                 constraintName="fk_invoice_role__invoice_item_id"
                                 referencedColumnNames="id"
                                 referencedTableName="invoice_item"
                                 />

        <addForeignKeyConstraint baseColumnNames="party_id"
                                 baseTableName="invoice_role"
                                 constraintName="fk_invoice_role__party_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="role_type_id"
                                 baseTableName="invoice_role"
                                 constraintName="fk_invoice_role__role_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="role_type"
                                 />
    </changeSet>
</databaseChangeLog>
