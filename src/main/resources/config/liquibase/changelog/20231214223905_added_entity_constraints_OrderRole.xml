<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity OrderRole.
    -->
    <changeSet id="20231214223905-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="order_id"
                                 baseTableName="order_role"
                                 constraintName="fk_order_role__order_id"
                                 referencedColumnNames="id"
                                 referencedTableName="sys_order"
                                 />

        <addForeignKeyConstraint baseColumnNames="order_item_id"
                                 baseTableName="order_role"
                                 constraintName="fk_order_role__order_item_id"
                                 referencedColumnNames="id"
                                 referencedTableName="order_item"
                                 />

        <addForeignKeyConstraint baseColumnNames="party_id"
                                 baseTableName="order_role"
                                 constraintName="fk_order_role__party_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="role_type_id"
                                 baseTableName="order_role"
                                 constraintName="fk_order_role__role_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="role_type"
                                 />
    </changeSet>
</databaseChangeLog>
