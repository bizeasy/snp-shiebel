<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity ReturnItem.
    -->
    <changeSet id="20231214231605-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="return_header_id"
                                 baseTableName="return_item"
                                 constraintName="fk_return_item__return_header_id"
                                 referencedColumnNames="id"
                                 referencedTableName="return_header"
                                 />

        <addForeignKeyConstraint baseColumnNames="return_type_id"
                                 baseTableName="return_item"
                                 constraintName="fk_return_item__return_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="return_header_type"
                                 />

        <addForeignKeyConstraint baseColumnNames="product_id"
                                 baseTableName="return_item"
                                 constraintName="fk_return_item__product_id"
                                 referencedColumnNames="id"
                                 referencedTableName="product"
                                 />

        <addForeignKeyConstraint baseColumnNames="order_item_id"
                                 baseTableName="return_item"
                                 constraintName="fk_return_item__order_item_id"
                                 referencedColumnNames="id"
                                 referencedTableName="order_item"
                                 />

        <addForeignKeyConstraint baseColumnNames="status_id"
                                 baseTableName="return_item"
                                 constraintName="fk_return_item__status_id"
                                 referencedColumnNames="id"
                                 referencedTableName="status"
                                 />
    </changeSet>
</databaseChangeLog>
