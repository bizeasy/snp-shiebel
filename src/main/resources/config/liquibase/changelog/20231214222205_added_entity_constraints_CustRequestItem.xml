        <addForeignKeyConstraint baseColumnNames="product_id"
                                 baseTableName="cust_request_item"
                                 constraintName="fk_cust_request_item__product_id"
                                 referencedColumnNames="id"
                                 referencedTableName="product"
                                 />

        <addForeignKeyConstraint baseColumnNames="uom_id"
                                 baseTableName="cust_request_item"
                                 constraintName="fk_cust_request_item__uom_id"
                                 referencedColumnNames="id"
                                 referencedTableName="uom"
                                 />

        <addForeignKeyConstraint baseColumnNames="shopping_list_item_id"
