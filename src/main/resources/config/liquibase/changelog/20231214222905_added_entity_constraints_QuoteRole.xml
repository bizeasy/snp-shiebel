<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity QuoteRole.
    -->
    <changeSet id="20231214222905-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="quote_id"
                                 baseTableName="quote_role"
                                 constraintName="fk_quote_role__quote_id"
                                 referencedColumnNames="id"
                                 referencedTableName="quote"
                                 />

        <addForeignKeyConstraint baseColumnNames="quote_item_id"
                                 baseTableName="quote_role"
                                 constraintName="fk_quote_role__quote_item_id"
                                 referencedColumnNames="id"
                                 referencedTableName="quote_item"
                                 />

        <addForeignKeyConstraint baseColumnNames="party_id"
                                 baseTableName="quote_role"
                                 constraintName="fk_quote_role__party_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="role_type_id"
                                 baseTableName="quote_role"
                                 constraintName="fk_quote_role__role_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="role_type"
                                 />
    </changeSet>
</databaseChangeLog>
