    <!--
        Added the constraints for entity PicklistRole.
    -->
    <changeSet id="20231214231305-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="pick_list_id"
                                 baseTableName="picklist_role"
                                 constraintName="fk_picklist_role__pick_list_id"
