        <addForeignKeyConstraint baseColumnNames="role_type_id"
                                 baseTableName="picklist_role"
                                 constraintName="fk_picklist_role__role_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="role_type"
                                 />
    </changeSet>
</databaseChangeLog>
