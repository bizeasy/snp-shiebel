<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity ProductAssoc.
    -->
    <changeSet id="20231214213805-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="product_id"
                                 baseTableName="product_assoc"
                                 constraintName="fk_product_assoc__product_id"
                                 referencedColumnNames="id"
                                 referencedTableName="product"
                                 />

        <addForeignKeyConstraint baseColumnNames="product_to_id"
                                 baseTableName="product_assoc"
                                 constraintName="fk_product_assoc__product_to_id"
                                 referencedColumnNames="id"
                                 referencedTableName="product"
                                 />

        <addForeignKeyConstraint baseColumnNames="product_assoc_type_id"
                                 baseTableName="product_assoc"
                                 constraintName="fk_product_assoc__product_assoc_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="product_assoc_type"
                                 />
    </changeSet>
</databaseChangeLog>
