    <!--
        Added the constraints for entity ProductFacilityLocation.
    -->
    <changeSet id="20231214220805-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="product_id"
                                 baseTableName="product_facility_location"
                                 constraintName="fk_product_facility_location__product_id"
                                 referencedColumnNames="id"
