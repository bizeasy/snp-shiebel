<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Department.
    -->
    <changeSet id="20231214212405-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="parent_id"
                                 baseTableName="department"
                                 constraintName="fk_department__parent_id"
                                 referencedColumnNames="id"
                                 referencedTableName="department"
                                 />

        <addForeignKeyConstraint baseColumnNames="head_id"
                                 baseTableName="department"
                                 constraintName="fk_department__head_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="product_store_id"
                                 baseTableName="department"
                                 constraintName="fk_department__product_store_id"
                                 referencedColumnNames="id"
                                 referencedTableName="product_store"
                                 />
    </changeSet>
</databaseChangeLog>
