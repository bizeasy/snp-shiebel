<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity PaymentApplication.
    -->
    <changeSet id="20231214225605-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="payment_id"
                                 baseTableName="payment_application"
                                 constraintName="fk_payment_application__payment_id"
                                 referencedColumnNames="id"
                                 referencedTableName="payment"
                                 />

        <addForeignKeyConstraint baseColumnNames="to_payment_id"
                                 baseTableName="payment_application"
                                 constraintName="fk_payment_application__to_payment_id"
                                 referencedColumnNames="id"
                                 referencedTableName="payment"
                                 />

        <addForeignKeyConstraint baseColumnNames="invoice_id"
                                 baseTableName="payment_application"
                                 constraintName="fk_payment_application__invoice_id"
                                 referencedColumnNames="id"
                                 referencedTableName="invoice"
                                 />

        <addForeignKeyConstraint baseColumnNames="invoice_item_id"
                                 baseTableName="payment_application"
                                 constraintName="fk_payment_application__invoice_item_id"
                                 referencedColumnNames="id"
                                 referencedTableName="invoice_item"
                                 />

        <addForeignKeyConstraint baseColumnNames="order_id"
                                 baseTableName="payment_application"
                                 constraintName="fk_payment_application__order_id"
                                 referencedColumnNames="id"
                                 referencedTableName="sys_order"
                                 />

        <addForeignKeyConstraint baseColumnNames="order_item_id"
                                 baseTableName="payment_application"
                                 constraintName="fk_payment_application__order_item_id"
                                 referencedColumnNames="id"
                                 referencedTableName="order_item"
                                 />
    </changeSet>
</databaseChangeLog>
