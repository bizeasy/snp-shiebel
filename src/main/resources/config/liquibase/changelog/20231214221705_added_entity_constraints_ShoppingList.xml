                                 referencedTableName="party"
                                 />

        <addForeignKeyConstraint baseColumnNames="status_id"
                                 baseTableName="shopping_list"
                                 constraintName="fk_shopping_list__status_id"
                                 referencedColumnNames="id"
                                 referencedTableName="status"
                                 />
    </changeSet>
</databaseChangeLog>
