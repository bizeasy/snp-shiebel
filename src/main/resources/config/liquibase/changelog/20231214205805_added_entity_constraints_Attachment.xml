<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Attachment.
    -->
    <changeSet id="20231214205805-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="content_type_id"
                                 baseTableName="attachment"
                                 constraintName="fk_attachment__content_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="content_type"
                                 />

        <addForeignKeyConstraint baseColumnNames="folder_id"
                                 baseTableName="attachment"
                                 constraintName="fk_attachment__folder_id"
                                 referencedColumnNames="id"
                                 referencedTableName="file_folder"
                                 />

        <addForeignKeyConstraint baseColumnNames="owner_id"
                                 baseTableName="attachment"
                                 constraintName="fk_attachment__owner_id"
                                 referencedColumnNames="id"
                                 referencedTableName="party"
                                 />
    </changeSet>
</databaseChangeLog>
